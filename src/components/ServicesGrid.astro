---
import Icon from './Icon.astro';
import { services } from '../data/content';

interface Props {
  /** Show bullet points under each service (used on the Services page) */
  detailed?: boolean;
  alt?: boolean;
}
const { detailed = false, alt = false } = Astro.props;
---

<section class:list={['section', { alt }]} id="services">
  <div class="container">
    <div class="section-head reveal">
      <span class="topper">Our Services</span>
      <h2 class="title">Everything You Need To <span class="hl">Grow Online</span></h2>
      <p class="lead">From a brand-new website to getting found on Google, FRX Web Studio is your one-stop digital partner.</p>
    </div>

    <ul class="grid">
      {
        services.map((s, i) => (
          <li class="card svc reveal" style={`--delay:${(i % 3) * 0.08}s`}>
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="icon-badge">
              <Icon name={s.icon} size={26} />
            </span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            {detailed && (
              <ul class="check-list">
                {s.points.map((p) => (
                  <li>
                    <Icon name="check" size={16} /> {p}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>

    {
      !detailed && (
        <div class="more reveal">
          <a href="/services" class="btn">
            View All Services <Icon name="arrow-right" size={18} />
          </a>
        </div>
      )
    }
  </div>
</section>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }
  .svc {
    position: relative;
    padding: 2.25rem 1.9rem;
    transition: transform 0.3s, background-color 0.3s, border-color 0.3s;
  }
  .svc:hover {
    transform: translateY(-6px);
    border-color: var(--sky);
  }
  .num {
    position: absolute;
    top: 1.25rem;
    right: 1.5rem;
    font-family: var(--font-heading);
    font-size: 3rem;
    font-weight: 700;
    line-height: 1;
    color: var(--sky);
    opacity: 0.18;
  }
  h3 {
    margin: 1.25rem 0 0.6rem;
    font-size: 1.3rem;
    letter-spacing: 0.03em;
  }
  .check-list {
    margin-top: 1.25rem;
    gap: 0.4rem;
    font-size: 0.97rem;
    font-weight: 600;
    color: var(--heading);
  }
  .more {
    display: flex;
    justify-content: center;
    margin-top: 3rem;
  }
</style>
