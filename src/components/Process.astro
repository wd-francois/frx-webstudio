---
import { process } from '../data/content';
---

<section class="section alt">
  <div class="container">
    <div class="section-head reveal">
      <span class="topper">How It Works</span>
      <h2 class="title">From First Chat To <span class="hl">Launch Day</span></h2>
      <p class="lead">A simple, stress-free process. You’ll always know what’s happening and what comes next.</p>
    </div>

    <ol class="steps">
      {
        process.map((s, i) => (
          <li class="step reveal" style={`--delay:${i * 0.1}s`}>
            <span class="n">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2.5rem 1.5rem;
    counter-reset: step;
  }
  @media (min-width: 40rem) {
    .steps {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 64rem) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .step {
    position: relative;
    text-align: center;
    padding: 0 0.5rem;
  }
  @media (min-width: 64rem) {
    .step:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 2.25rem;
      left: calc(50% + 3rem);
      width: calc(100% - 6rem + 1.5rem);
      border-top: 2px dashed var(--sky);
      opacity: 0.6;
    }
  }
  .n {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    margin: 0 auto 1.25rem;
    border-radius: 50%;
    background: var(--navy);
    color: #fff;
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    box-shadow: 0 0 0 8px rgb(67 183 255 / 0.18);
  }
  :global([data-theme='dark']) .n {
    background: var(--sky);
    color: var(--navy);
  }
  h3 {
    margin-bottom: 0.5rem;
    font-size: 1.3rem;
  }
</style>
