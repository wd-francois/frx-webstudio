---
import Icon from './Icon.astro';
import { site } from '../config/site';

---

<!-- Netlify Forms: Netlify detects this form at deploy time and emails each submission. -->
<form
  class="form card"
  id="contact-form"
  name="contact"
  action="/thank-you"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
>
  <input type="hidden" name="form-name" value="contact" />
  <input type="hidden" name="subject" value={`New website enquiry — ${site.name}`} />
  <!-- Honeypot: bots fill this, humans never see it -->
  <p class="hp" aria-hidden="true">
    <label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
  </p>

  <h2>Request Your Free Quote</h2>
  <p class="intro">Tell me a little about your project. I’ll reply within one business day.</p>

  <div class="row">
    <label>
      <span>Full name *</span>
      <input type="text" name="name" autocomplete="name" required placeholder="Jane Smith" />
    </label>
    <label>
      <span>Email *</span>
      <input type="email" name="email" autocomplete="email" required placeholder="jane@business.com" />
    </label>
  </div>

  <div class="row">
    <label>
      <span>Phone</span>
      <input type="tel" name="phone" autocomplete="tel" placeholder="Optional" />
    </label>
    <label>
      <span>Business name</span>
      <input type="text" name="business" autocomplete="organization" placeholder="Optional" />
    </label>
  </div>

  <label>
    <span>I’m interested in</span>
    <select name="service">
      <option>A new website</option>
      <option>Redesigning my current website</option>
      <option>Local SEO</option>
      <option>Hosting &amp; care plan</option>
      <option>Not sure yet</option>
    </select>
  </label>

  <label>
    <span>Tell me about your project *</span>
    <textarea name="message" rows="5" required placeholder="What does your business do, and what would you like your new website to achieve?"></textarea>
  </label>

  <button type="submit" class="btn submit">
    <span class="label">Send My Enquiry</span>
    <Icon name="arrow-right" size={18} />
  </button>
  <p class="status" role="status" aria-live="polite"></p>
  <p class="fine">No spam, ever. Your details are only used to reply to your enquiry. See our <a href="/privacy">privacy policy</a>.</p>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    const status = form.querySelector<HTMLElement>('.status')!;
    const btn = form.querySelector<HTMLButtonElement>('.submit')!;
    const label = btn.querySelector<HTMLElement>('.label')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.className = 'status';

      btn.disabled = true;
      label.textContent = 'Sending…';
      try {
        const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString();
        const res = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body,
        });
        if (!res.ok) throw new Error(String(res.status));
        window.location.href = '/thank-you';
      } catch {
        status.textContent = 'Sorry, something went wrong. Please try again or email us directly.';
        status.classList.add('error');
        btn.disabled = false;
        label.textContent = 'Send My Enquiry';
      }
    });
  }
</script>

<style>
  .form {
    display: grid;
    gap: 1.1rem;
    padding: clamp(1.75rem, 4vw, 2.75rem);
  }
  h2 {
    font-size: clamp(1.6rem, 3vw, 2rem);
  }
  .intro {
    margin-top: -0.5rem;
  }
  .row {
    display: grid;
    gap: 1.1rem;
  }
  @media (min-width: 40rem) {
    .row {
      grid-template-columns: 1fr 1fr;
    }
  }
  label {
    display: grid;
    gap: 0.4rem;
  }
  label span {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--heading);
  }
  input,
  select,
  textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    border: 1px solid var(--border);
    border-radius: 0.65rem;
    background: var(--bg);
    color: var(--heading);
    font: inherit;
    font-size: 1rem;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  textarea {
    resize: vertical;
  }
  input::placeholder,
  textarea::placeholder {
    color: var(--muted);
    opacity: 0.8;
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--sky);
    box-shadow: 0 0 0 4px rgb(67 183 255 / 0.2);
  }
  .hp {
    display: none;
  }
  .submit {
    justify-self: start;
    margin-top: 0.5rem;
  }
  .submit:disabled {
    opacity: 0.7;
    cursor: wait;
  }
  .status:empty {
    display: none;
  }
  .status.error {
    padding: 0.75rem 1rem;
    border-radius: 0.6rem;
    background: rgb(239 68 68 / 0.12);
    color: #dc2626;
    font-weight: 600;
  }
  :global([data-theme='dark']) .status.error {
    color: #fca5a5;
  }
  .fine {
    font-size: 0.875rem;
    color: var(--muted);
  }
</style>
