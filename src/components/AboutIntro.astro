---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import profile from '../assets/profile.jpg';
import { site } from '../config/site';

interface Props {
  /** Show the "Learn more" button (hide on the About page itself) */
  showLink?: boolean;
}
const { showLink = true } = Astro.props;
---

<section class="section about">
  <div class="container inner">
    <div class="photo-wrap reveal">
      <div class="dots dots-photo" aria-hidden="true"></div>
      <Image
        src={profile}
        alt={`${site.founder.name}, founder of ${site.name}`}
        width={1100}
        widths={[480, 760, 1100]}
        sizes="(min-width: 64rem) 34rem, 92vw"
        class="photo"
        loading="lazy"
      />
      <div class="name-tag">
        <strong>{site.founder.name}</strong>
        <span>{site.founder.role}</span>
      </div>
    </div>

    <div class="copy reveal" style="--delay:.1s">
      <span class="topper">Meet The Founder</span>
      <h2 class="title">A Real Person Behind <span class="hl">Every Website</span></h2>
      <p>
        Hi, I’m {site.founder.name}. I started {site.name} because too many small businesses are stuck with slow,
        outdated or overpriced websites — or are paying big agencies for work handed off to someone they’ll never speak to.
      </p>
      <p>
        When you work with FRX, you work with me directly. I’ll take the time to understand your business, design a site
        that reflects it, and hand-code it to be fast, secure and easy for customers to find. And once you’re live, I’m
        still just a message away.
      </p>
      <ul class="check-list">
        <li><Icon name="check" size={18} /> Direct contact with your designer — no middlemen</li>
        <li><Icon name="check" size={18} /> Honest advice and fixed, upfront quotes</li>
        <li><Icon name="check" size={18} /> Modern design that’s built to generate enquiries</li>
      </ul>
      {showLink && <a href="/about" class="btn">More About Us <Icon name="arrow-right" size={18} /></a>}
    </div>
  </div>
</section>

<style>
  .inner {
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
    align-items: center;
  }
  @media (min-width: 64rem) {
    .inner {
      grid-template-columns: 0.9fr 1fr;
    }
  }
  .photo-wrap {
    position: relative;
    max-width: 34rem;
    width: 100%;
    margin: 0 auto;
  }
  .photo-wrap::before {
    content: '';
    position: absolute;
    inset: 1.25rem -1.25rem -1.25rem 1.25rem;
    border: 3px solid var(--sky);
    border-radius: 1.25rem;
  }
  .dots-photo {
    top: -1.5rem;
    left: -1.5rem;
    width: 9rem;
    height: 9rem;
  }
  .photo-wrap :global(.photo) {
    position: relative;
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    object-position: 45% 30%;
    border-radius: 1.25rem;
    box-shadow: var(--shadow-lg);
  }
  .name-tag {
    position: absolute;
    left: 1.25rem;
    bottom: 1.25rem;
    display: grid;
    padding: 0.8rem 1.2rem;
    border-radius: 0.8rem;
    background: var(--navy);
    color: #cfe3f5;
    box-shadow: var(--shadow);
    font-size: 0.9rem;
  }
  .name-tag strong {
    color: #fff;
    font-family: var(--font-heading);
    font-size: 1.2rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .copy p {
    margin-bottom: 1rem;
  }
  .check-list {
    margin: 1.5rem 0 2rem;
    font-weight: 600;
    color: var(--heading);
  }
</style>
