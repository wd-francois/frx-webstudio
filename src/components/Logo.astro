---
// FRX Web Studio logo: "FR" + split X wordmark, divider, "Web Studio".
// `inverse` renders light text for dark backgrounds (e.g. the footer).
interface Props {
  inverse?: boolean;
}
const { inverse = false } = Astro.props;
---

<a href="/" class:list={['logo', { inverse }]} aria-label="FRX Web Studio — home">
  <span class="mark" aria-hidden="true">
    <span class="fr">FR</span>
    <!-- Drawn on Oswald Bold's metrics: 813 cap height, 516 X width, ~188 stem. -->
    <svg class="x" viewBox="0 0 516 813">
      <path d="M0 0h200l316 813H316z" class="x-bar-light" />
      <path d="M316 0h200L200 813H0z" class="x-bar-accent" />
    </svg>
  </span>
  <span class="divider" aria-hidden="true"></span>
  <span class="studio" aria-hidden="true">Web Studio</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--heading);
    line-height: 1;
  }
  .mark {
    display: inline-flex;
    align-items: baseline;
    font-family: var(--font-heading);
    font-size: 2.6rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .x {
    flex: none;
    width: 0.516em;
    height: 0.813em;
    margin-left: 0.03em;
    transition: transform 0.3s;
  }
  .logo:hover .x {
    transform: rotate(-8deg) scale(1.05);
  }
  .x-bar-light {
    fill: currentColor;
  }
  .x-bar-accent {
    fill: var(--sky-strong);
  }
  .divider {
    flex: none;
    width: 1px;
    height: 2.1rem;
    background: var(--border);
  }
  .studio {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    white-space: nowrap;
    text-transform: uppercase;
    color: var(--sky-strong);
  }
  .inverse {
    color: #fff;
  }
  .inverse .x-bar-accent {
    fill: var(--sky);
  }
  .inverse .studio {
    color: var(--sky);
  }
  .inverse .divider {
    background: rgb(255 255 255 / 0.25);
  }
</style>
