---
// FRX Web Studio logo: "FR" + split X wordmark, divider, "Web Studio".
// `inverse` renders light text for dark backgrounds (e.g. the footer).
interface Props {
  inverse?: boolean;
}
const { inverse = false } = Astro.props;
---

<a href="/" class:list={['logo', { inverse }]} aria-label="FRX Web Studio — home">
  <span class="mark" aria-hidden="true">
    <span class="fr">FR</span>
    <svg class="x" viewBox="0 0 56 64">
      <line x1="10" y1="4" x2="46" y2="60" class="x-bar-light" />
      <line x1="46" y1="4" x2="10" y2="60" class="x-bar-accent" />
    </svg>
  </span>
  <span class="divider" aria-hidden="true"></span>
  <span class="studio" aria-hidden="true">Web Studio</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--heading);
    line-height: 1;
  }
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.06em;
    font-family: var(--font-heading);
    font-size: 2.1rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .x {
    flex: none;
    width: 0.68em;
    height: 0.77em;
    transition: transform 0.3s;
  }
  .logo:hover .x {
    transform: rotate(-8deg) scale(1.05);
  }
  .x-bar-light {
    stroke: currentColor;
    stroke-width: 12;
  }
  .x-bar-accent {
    stroke: var(--sky-strong);
    stroke-width: 12;
  }
  .divider {
    flex: none;
    width: 1px;
    height: 1.75rem;
    background: var(--border);
  }
  .studio {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--sky-strong);
  }
  .inverse {
    color: #fff;
  }
  .inverse .x-bar-accent,
  .inverse .studio {
    stroke: var(--sky);
    color: var(--sky);
  }
  .inverse .divider {
    background: rgb(255 255 255 / 0.25);
  }
</style>
