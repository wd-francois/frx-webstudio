---
// FRX Web Studio logo: crossed-bar X mark + wordmark.
// `inverse` renders light text for dark backgrounds (e.g. the footer).
interface Props {
  inverse?: boolean;
}
const { inverse = false } = Astro.props;
---

<a href="/" class:list={['logo', { inverse }]} aria-label="FRX Web Studio — home">
  <svg class="mark" viewBox="0 0 48 48" width="44" height="44" aria-hidden="true">
    <rect width="48" height="48" rx="12" class="mark-bg" />
    <path d="M12 10h7l17 28h-7z" class="mark-bar-light" />
    <path d="M29 10h7L19 38h-7z" class="mark-bar-accent" />
  </svg>
  <span class="word">
    <span class="frx">FRX</span>
    <span class="studio">Web Studio</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--heading);
    line-height: 1;
  }
  .mark {
    flex: none;
    transition: transform 0.3s;
  }
  .logo:hover .mark {
    transform: rotate(-6deg) scale(1.05);
  }
  .mark-bg {
    fill: var(--navy);
  }
  :global([data-theme='dark']) .mark-bg,
  .inverse .mark-bg {
    fill: #0f3460;
  }
  .mark-bar-light {
    fill: #fff;
  }
  .mark-bar-accent {
    fill: var(--sky);
  }
  .word {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .frx {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .studio {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--sky-strong);
  }
  .inverse {
    color: #fff;
  }
  .inverse .studio {
    color: var(--sky);
  }
</style>
